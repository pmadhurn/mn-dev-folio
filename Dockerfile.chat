FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.136.1 uvicorn==0.47.0 httpx==0.28.1 pydantic==2.13.4
COPY server.py ./
COPY public-context ./public-context
ENV HOST=0.0.0.0 PORT=5000 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 1001:1001
EXPOSE 5000
CMD ["python", "server.py"]
